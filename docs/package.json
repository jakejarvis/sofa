{
  "name": "sofa-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bun --bun next build",
    "dev": "bun --bun next dev",
    "start": "bun --bun next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "bun --bun fumadocs-mdx && bun --bun next typegen && tsc --noEmit",
    "generate:api-docs": "bun scripts/generate-api-docs.ts",
    "postinstall": "bun --bun fumadocs-mdx"
  },
  "dependencies": {
    "@takumi-rs/image-response": "^2.14.0",
    "@vercel/analytics": "^2.0.1",
    "fumadocs-core": "^16.16.1",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-openapi": "^12.3.0",
    "fumadocs-ui": "^16.16.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "packageManager": "bun@1.4.2"
}
